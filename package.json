{
  "name": "rofin-ui",
  "version": "0.1.0",
  "description": "Modular HTML, CSS, and vanilla JavaScript components with zero runtime dependencies.",
  "license": "MIT",
  "author": "Robin Francis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robinfrancis186/rofin-ui.git"
  },
  "homepage": "https://github.com/robinfrancis186/rofin-ui#readme",
  "bugs": {
    "url": "https://github.com/robinfrancis186/rofin-ui/issues"
  },
  "style": "./dist/rofin.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rofin.js",
      "require": "./dist/rofin.cjs"
    },
    "./auto": "./src/js/auto.js",
    "./effects": "./src/js/effects.js",
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "import": "./dist/patterns.js"
    },
    "./patterns.css": "./dist/patterns.css",
    "./style.css": "./dist/rofin.css",
    "./effects.css": "./dist/effects.css",
    "./sections.css": "./dist/sections.css",
    "./css/*": "./src/*.css",
    "./js/*": "./src/js/*.js",
    "./tokens.css": "./src/tokens.css",
    "./button.css": "./src/button.css",
    "./card.css": "./src/card.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.css",
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.json",
    "dist/*.ts",
    "src",
    "examples",
    "sections"
  ],
  "keywords": [
    "ui",
    "css",
    "html",
    "components",
    "zero-dependencies"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  },
  "type": "module",
  "main": "./dist/rofin.cjs",
  "module": "./dist/rofin.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./src/js/auto.js",
    "./dist/rofin.auto.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "playwright test",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run build && npm test && npm run test:package",
    "prepack": "npm run build"
  }
}
